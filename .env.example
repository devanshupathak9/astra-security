# Copy this file to .env and fill in your keys:   cp .env.example .env
# Each name must appear only ONCE in .env (if a name is repeated, the last value wins).

# =============================================================================
# 1. API keys - only the ones for the providers you use
# =============================================================================
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...                # free, no card: https://console.groq.com
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# XAI_API_KEY=xai-...

# =============================================================================
# 2. Teacher (strong model) and student (small model)
#    Default below = the tested setup: OpenAI teacher, open-weight student on Groq.
#    List the model ids a key can use:  python main.py models --model teacher
# =============================================================================
TEACHER_MODEL=gpt-6.1-sol

STUDENT_MODEL=openai/gpt-oss-20b
STUDENT_BASE_URL=https://api.groq.com/openai/v1
STUDENT_API_KEY_ENV=GROQ_API_KEY

# Each role reads these variables (replace TEACHER with STUDENT for the student):
#   TEACHER_MODEL            model id (required)
#   TEACHER_PROVIDER         openai (default, any OpenAI-compatible API) | anthropic
#   TEACHER_BASE_URL         API address; empty = api.openai.com
#   TEACHER_API_KEY_ENV      NAME of the variable holding the key (default OPENAI_API_KEY)
#   TEACHER_TEMPERATURE      empty = model default (newer OpenAI models require this)
#   TEACHER_MAX_CHUNK_CHARS  code per request (teacher 20000, student 12000)
#   TEACHER_MAX_TOKENS       reply limit (teacher 16000, student 8192)

# =============================================================================
# 3. Other providers - copy a block above in place of the teacher/student lines
# =============================================================================
# Claude (Anthropic SDK):
#   TEACHER_PROVIDER=anthropic
#   TEACHER_MODEL=claude-sonnet-5-5
#   TEACHER_API_KEY_ENV=ANTHROPIC_API_KEY
#
# Gemini (OpenAI-compatible endpoint):
#   TEACHER_MODEL=gemini-2.5-pro
#   TEACHER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   TEACHER_API_KEY_ENV=GEMINI_API_KEY
#
# Grok (xAI, OpenAI-compatible endpoint):
#   TEACHER_MODEL=grok-4
#   TEACHER_BASE_URL=https://api.x.ai/v1
#   TEACHER_API_KEY_ENV=XAI_API_KEY
#
# Student fully on OpenAI instead of Groq:
#   STUDENT_MODEL=gpt-5.4-nano          (and delete STUDENT_BASE_URL / STUDENT_API_KEY_ENV)
#
# Local model with Ollama (any non-empty key works):
#   STUDENT_MODEL=llama3.1:8b
#   STUDENT_BASE_URL=http://localhost:11434/v1
#   STUDENT_API_KEY_ENV=OLLAMA_API_KEY   (and set OLLAMA_API_KEY=ollama)

# =============================================================================
# 4. Optional experiment settings
# =============================================================================
# STUDENTS=student,student2         # also run student2 (gpt-oss-20b on Groq, see config.yaml)
# STUDENT_RUNS=3                    # repeat each student scan to measure variance
