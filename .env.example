# ---- API keys --------------------------------------------------------------
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...              # only needed for a student on Groq (free: console.groq.com)

# ---- Teacher (frontier model) -----------------------------------------------
# Exact id from: python main.py models --model teacher
TEACHER_MODEL=

# ---- Student (small, cheap model) -------------------------------------------
# Exact id from: python main.py models --model student
STUDENT_MODEL=

# Student on Groq instead of OpenAI (open-weight models, free tier) - uncomment:
# STUDENT_MODEL=openai/gpt-oss-20b
# STUDENT_BASE_URL=https://api.groq.com/openai/v1
# STUDENT_API_KEY_ENV=GROQ_API_KEY

# ---- Optional -----------------------------------------------------------------
# STUDENTS=student,student2       # also test student2 (gpt-oss-20b on Groq) in the loop
# STUDENT_RUNS=3                  # repeat each student scan to measure variance
# TEACHER_TEMPERATURE=0           # empty = model default (required by newer OpenAI models)
# STUDENT_TEMPERATURE=0
# TEACHER_PROVIDER=anthropic      # Claude teacher; then TEACHER_API_KEY_ENV=ANTHROPIC_API_KEY
